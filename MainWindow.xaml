<Window x:Class="Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:viewmodel="clr-namespace:Test.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:VM}"
        mc:Ignorable="d"
        Title="Тестирование стратегии" Height="1000" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <!--   <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />-->
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
      
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="Возврат инструмента к простой средней линии" HorizontalAlignment="Center" FontSize="24"></TextBlock>
            <TextBlock Text="Количество стандартных отклонений" HorizontalAlignment="Center" FontSize="20"></TextBlock>
            <TextBox Text="{Binding NumberOfStandardDeviations, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Text="Период расчёта стандартного отклонения и простой средней линии" HorizontalAlignment="Center" FontSize="20"></TextBlock>
            <TextBox Text="{Binding Period, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  HorizontalAlignment="Center" FontSize="20"/>

            <Button Command="{Binding PlotCommand}" FontSize="20" >Рассчитать с введенными параметрами</Button>
            <Button Command="{Binding ClearPlot}" FontSize="20">Очистить график</Button>

        </StackPanel>
<!--
        <ContentControl Content="{Binding PlotControl, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="0" Grid.Row="1"/>

        <ContentControl Content="{Binding PlotControl1, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="0" Grid.Row="2"/>

        <ContentControl Content="{Binding PlotControl2, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="0" Grid.Row="3"/>


        <ContentControl Content="{Binding PlotControl3, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="0" Grid.Row="4"/>
-->
        <ContentControl Content="{Binding PlotControl3, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="0" Grid.Row="1"/>

    </Grid>
    
  </Window>
